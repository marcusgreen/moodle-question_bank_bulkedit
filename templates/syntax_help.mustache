{{!
    @template qbank_bulkedit/syntax_help

    Reference table for the simple pattern syntax.

    Example context (json):
    {}
}}
<details class="qbank-bulkedit-syntax mt-3">
    <summary>{{#str}}syntaxhelp, qbank_bulkedit{{/str}}</summary>
    <table class="table table-sm generaltable w-auto">
        <thead>
            <tr>
                <th scope="col">{{#str}}syntaxtoken, qbank_bulkedit{{/str}}</th>
                <th scope="col">{{#str}}syntaxmeaning, qbank_bulkedit{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            <tr><td><code>*</code></td><td>{{#str}}syntax_star, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>?</code></td><td>{{#str}}syntax_question, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>{word}</code></td><td>{{#str}}syntax_word, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>{n}</code></td><td>{{#str}}syntax_n, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>{line}</code></td><td>{{#str}}syntax_line, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>^</code> <code>$</code></td><td>{{#str}}syntax_anchor, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>( )</code> &rarr; <code>$1</code></td><td>{{#str}}syntax_capture, qbank_bulkedit{{/str}}</td></tr>
            <tr><td><code>\</code></td><td>{{#str}}syntax_escape, qbank_bulkedit{{/str}}</td></tr>
        </tbody>
    </table>
    <p>{{#str}}syntax_example, qbank_bulkedit{{/str}}</p>
</details>
